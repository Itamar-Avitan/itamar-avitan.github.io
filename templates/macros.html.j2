{#- Shared markup for every page. Imported "with context", so the macros can read `site` and `base`.
    Optional keys (url, note, text, link, links, venue on the paper card, ongoing, authors, figure, me, role,
    nobreak) are tested before use, because the build renders with StrictUndefined. -#}

{#- Wrap the no-break terms listed in site.yaml; the text is escaped first, so content can never inject markup.
    Then the titles of works (`works` in site.yaml) go in <i class="work">, so a book or a long poem is set in
    italic wherever the text names one (deep review 2026-09-25, DS-07); the italic face is self-hosted with the
    others. After the no-break loop on purpose: a title may hold a tied term, and a term is never a title. -#}
{%- macro nb(text) -%}
  {%- set ns = namespace(out=text) -%}
  {%- for term in site.get("nobreak") or [] -%}
    {%- set ns.out = ns.out|replace(term, ('<span class="nb">'|safe) ~ term ~ ('</span>'|safe)) -%}
  {%- endfor -%}
  {%- for work in site.get("works") or [] -%}
    {%- set ns.out = ns.out|replace(work, ('<i class="work">'|safe) ~ work ~ ('</i>'|safe)) -%}
  {%- endfor -%}
  {{- ns.out -}}
{%- endmacro -%}

{%- set MONTHS = {"Jan": "01", "Feb": "02", "Mar": "03", "Apr": "04", "May": "05", "Jun": "06",
                  "Jul": "07", "Aug": "08", "Sep": "09", "Oct": "10", "Nov": "11", "Dec": "12"} -%}

{#- The machine-readable form of ["2026"], ["Sep", "2026"] or ["14", "Sep", "2026"]; empty when it cannot be read. -#}
{%- macro iso(words) -%}
  {%- set year = words[-1] -%}
  {%- set month = MONTHS.get(words[-2][:3]) if words|length > 1 else none -%}
  {%- set day = words[0]|int(0) if words|length == 3 else 0 -%}
  {%- if year|length == 4 and year|int(0) >= 1000 -%}
    {%- if words|length == 1 -%}
      {{- year -}}
    {%- elif words|length == 2 and month -%}
      {{- year }}-{{ month -}}
    {%- elif words|length == 3 and month and 1 <= day <= 31 -%}
      {{- year }}-{{ month }}-{{ "%02d"|format(day) -}}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{#- A date or a range of two dates as <time> elements. The left side of a range borrows the words it leaves out from
    the right side: "14–15 Sep 2026", "24 Jul–6 Aug 2026", "2022–2023". Anything else stays plain text.
    With cls the result is one element carrying that class (a row's "when" or "what"). -#}
{%- macro dates(text, cls=none) -%}
  {%- set sides = text.split("–") -%}
  {%- set last = sides[-1].split(" ") -%}
  {%- set ns = namespace(stamps=[]) -%}
  {%- for side in sides -%}
    {%- set own = side.split(" ") -%}
    {%- set ns.stamps = ns.stamps + [iso(own + last[own|length:])] -%}
  {%- endfor -%}
  {%- set readable = sides|length <= 2 and "" not in ns.stamps -%}
  {%- if readable and cls and sides|length == 1 -%}
    <time class="{{ cls }}" datetime="{{ ns.stamps[0] }}">{{ text }}</time>
  {%- else -%}
    {%- if cls %}<span class="{{ cls }}">{% endif -%}
    {%- if readable -%}
      {%- for side in sides -%}
        <time datetime="{{ ns.stamps[loop.index0] }}">{{ side }}</time>{% if not loop.last %}–{% endif -%}
      {%- endfor -%}
    {%- else -%}
      {{- text -}}
    {%- endif -%}
    {%- if cls %}</span>{% endif -%}
  {%- endif -%}
{%- endmacro -%}

{#- The marks drawn before a link label, chosen by each link's "icon" key in site.yaml. One 16px solid shape
    each, one colour (fill: currentColor), and aria-hidden: the text label beside a mark is its accessible name,
    so the mark itself says nothing twice. They are inline, so the page still asks no other host for anything.

    THREE MARKS, AND ONLY THREE. The owner ruled on 2026-09-21 that this site draws a mark for Email, GitHub
    and Bluesky and for nothing else. Four were deleted that day and must not be put back:
      linkedin -- Simple Icons removed the LinkedIn mark on 2024-12-17 because LinkedIn's brand policy forbids
                  third-party use of the logo. There is no licensed file left to ship.
      orcid    -- ORCID's terms say the iD icon "must be used as provided, and must not be changed or altered
                  in any way". What stood here was a recoloured trace laid out at 12.4 CSS px, under ORCID's
                  documented 16px floor: altered twice over.
      scholar  -- the stand-in mortarboard closed into a blob below about 20px, and Google asks that its
                  product icons not be imitated, so there was no truer mark to reach for instead.
      x        -- X's brand terms could not be fetched, so permission could not be established at all.
    A missing mark here is not a bug to fix: those four links carry their text label, which is what says where
    they go. See the note above "links" in site.yaml, and the safe-subset test in tests/test_build.py.

    Licences and provenance of the three that remain: "mail" is drawn here, so no third party's terms apply to
    it -- it is an envelope, not anyone's brand. "github" and "bluesky" are the marks published by Simple Icons
    16.32.0 (CC0-1.0, https://github.com/simple-icons/simple-icons). CC0 asks for no attribution; it is
    recorded here because a brand mark is a trademark whatever its file licence says. Each is used unaltered
    and only as a link to the owner's own page -- the use both brand guides allow. Their colour rules ask for
    black or white; these follow the page instead, in the grey of its dates and labels, which is the one point
    where this falls short of the letter of the guides. -#}
{%- set ICONS = {
  "mail": "M4 4.5h16a2 2 0 0 1 2 2v.3l-10 6.1L2 6.8v-.3a2 2 0 0 1 2-2zM2 8.55v8.95a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.55l-9.48 5.78a1 1 0 0 1-1.04 0z",
  "github": "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  "bluesky": "M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026",
} -%}

{#- Each mark also carries its own class, because the three marks fill their 24x24 box very differently: the
    stylesheet sizes them one by one so they read as one set rather than as three weights. -#}
{%- macro icon(name) -%}
  {%- if name and ICONS.get(name) -%}
    <svg class="ico ico--{{ name }}" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="{{ ICONS[name] }}"/></svg>
  {%- endif -%}
{%- endmacro -%}

{%- macro authors(names, me) -%}
  {%- for name in names -%}
    {%- if name == me %}<span class="me">{{ name }}</span>{% else %}{{ name }}{% endif -%}
    {%- if not loop.last %}, {% endif -%}
  {%- endfor -%}
{%- endmacro -%}

{#- The role line under a name: "PhD candidate · Brains and Machines Lab · Ben-Gurion University of the Negev".
    Through nb(), because the stylesheet no longer sets the item nowrap: a rigid 344px box scrolled the page
    sideways as soon as the reader enlarged the text. "Ben-Gurion" is already in site.yaml's nobreak list, so
    this protects the hyphen from setting as "Ben-/Gurion" while letting the phrase wrap where a space is. -#}
{%- macro role_line() %}
{% if site.get("role") %}
      <ul class="role" role="list">
  {% for item in site.role %}
        <li>{% if item.get("url") %}<a href="{{ item.url }}">{{ nb(item.label) }}</a>{% else %}{{ nb(item.label) }}{% endif %}</li>
  {% endfor %}
      </ul>
{% endif %}
{% endmacro -%}

{#- Three lists, in this order: how to reach him, the profiles this site may mark, the profiles it may not.
    The split is the answer to a design problem, not a ranking. Only three of the six destinations allow their
    mark to be drawn here (see the note over ICONS), and a row in which three items out of six carry one,
    scattered, looks like three icons failed to load. Listing the marked ones first puts the marks side by
    side, which is what settles that; the stylesheet then sets one step between every pair of links, marked or
    plain, because a wider step between the two lists read at desktop width as a missing item rather than as
    two groups. The lists stay separate so that they wrap as whole groups. The envelope on the address above
    them gives the block a mark on its first line as well, so the left edge is the same shape all the way down.
    The CV is not here any more: it is the filled chip in the navigation strip, on every page.

    Two halves, because the home page says them in two places. The address belongs at the top of the front
    door, where a visitor who came to write to him is looking; six profile links there do not -- on a phone
    they broke into three ragged rows between the lede and the first word of the page, about 120px of link
    hedge before "About". So the profiles stand in the colophon of every page, the address in the masthead at
    home and in the colophon everywhere else. Each page still carries exactly one element with id="email",
    which is the hook the script in base.html.j2 turns into a mailto.

    `pick` (deep review, 2026-09-25, AS-25): the front door may repeat a few of the profiles beside the
    address -- the ones a recruiter and a peer actually open, GitHub and Google Scholar -- as items of the same
    reach list, so they share its row and its rhythm, in the order they are picked (GitHub first: it carries a
    mark, so the marks stay contiguous with the envelope, the rule the colophon row keeps). Those two are then
    said twice on the home page, top and colophon; the address is still said once. A picked link draws its
    mark if it has one (GitHub) and none if it does not (Scholar, by the three-mark ruling above). -#}
{%- macro contact(label, reach=true, profiles=true, pick=none) %}
      <nav class="links-nav" aria-label="{{ label }}">
{% if reach %}
        <ul class="links links--reach" role="list">
  {% for link in site.links if link.label == "Email" and link.get("text") %}
          <li class="links__email"><span class="links__label">{{ icon(link.get("icon")) }}{{ link.label }}</span> <span id="email">{{ link.text }}</span></li>
  {% endfor %}
  {% for label in pick or [] %}
    {% for link in site.links if link.label == label and link.get("url") %}
          <li><a rel="me" href="{{ link.url }}">{{ icon(link.get("icon")) }}<span>{{ link.label }}</span></a></li>
    {% endfor %}
  {% endfor %}
        </ul>
{% endif %}
{% if profiles %}
        <div class="links-row">
          <ul class="links links--marked" role="list">
  {% for link in site.links if link.label not in ("CV", "Email") and link.get("url") and link.get("icon") %}
            <li><a rel="me" href="{{ link.url }}">{{ icon(link.icon) }}<span>{{ link.label }}</span></a></li>
  {% endfor %}
          </ul>
          <ul class="links links--plain" role="list">
  {% for link in site.links if link.label not in ("CV", "Email") and link.get("url") and not link.get("icon") %}
            <li><a rel="me" href="{{ link.url }}"><span>{{ link.label }}</span></a></li>
  {% endfor %}
          </ul>
        </div>
{% endif %}
      </nav>
{% endmacro -%}

{#- The four marks of the paper card's explanatory diagram, one per stage of the model-recovery test, drawn
    for the owner's ruling of 2026-09-25 (ruling 3: known generating model -> simulated judgments -> fitted
    candidates -> the wrong winner). The site's own vocabulary and nothing else: outlined squares for the
    candidate networks, the odd-one-out triplet of the footer mark for a judgment, bars for a ranking. Rules,
    kept on purpose (deep review, WP-S3): the marks hold no text and no numeral -- the captions under them
    (`how` in site.yaml) are the labels, in the page's own font, and the <80% is printed once, in the Summary;
    every stroke and fill is currentColor (the stylesheet sets the strip's colour) except ONE accent object
    per stage, set with style="fill:var(--accent)" -- a var() in a presentation attribute is dropped by the
    sanitizers the footer mark was drawn for, so it stays in a style attribute; stage 3 has no accent, because
    at that stage the comparison does not know which network generated the answers, which is the point of the
    test; every stroke is at least 1.5 units; the four share one viewBox, one square size (9 units), one
    baseline (y = 60) and one left edge (ink from x = 1, flush with the caption's counter under it -- centred
    ink zig-zagged against the left-aligned captions once the strip wrapped; WP-S3 review), so they read as
    one strip. No arrow is drawn between stages: on a phone the strip wraps
    to two rows, and an arrow glyph in a wrapping grid points the wrong way on the second row -- the counter
    in the captions keeps the order. aria-hidden: each mark's caption is its accessible text.
      1  the generator: the 4x5 grid of 20 candidates, one filled in the accent -- the network whose turn it is
      2  simulated judgments: three odd-one-out triplets, the odd one out in the accent (one path, three
         squares: the same answer, given millions of times), and two shortening lines below for the rest of
         the pile
      3  fitted candidates: the same grid, all outlined, under a thin bracket, with a small arrow entering
         from the left -- the answers are what they are all fitted to
      4  the wrong winner: four ranked bars, each with a square at its head; the top bar's square is empty,
         and the accent-filled one, the generator, sits on the second bar -#}
{%- macro recovery_mark(n) -%}
  {%- if n == 1 -%}
<svg aria-hidden="true" viewBox="0 0 120 64"><path d="M1 12h9v9h-9zM14 12h9v9h-9zM27 12h9v9h-9zM40 12h9v9h-9zM53 12h9v9h-9zM1 25h9v9h-9zM14 25h9v9h-9zM27 25h9v9h-9zM53 25h9v9h-9zM1 38h9v9h-9zM14 38h9v9h-9zM27 38h9v9h-9zM40 38h9v9h-9zM53 38h9v9h-9zM1 51h9v9h-9zM14 51h9v9h-9zM27 51h9v9h-9zM40 51h9v9h-9zM53 51h9v9h-9z" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="40" y="25" width="9" height="9" style="fill:var(--accent)"/></svg>
  {%- elif n == 2 -%}
<svg aria-hidden="true" viewBox="0 0 120 64"><g fill="currentColor"><circle cx="5.5" cy="12.5" r="4.5"/><circle cx="20.5" cy="12.5" r="4.5"/><circle cx="5.5" cy="28.5" r="4.5"/><circle cx="20.5" cy="28.5" r="4.5"/><circle cx="5.5" cy="44.5" r="4.5"/><circle cx="20.5" cy="44.5" r="4.5"/></g><path d="M31 8h9v9h-9zM31 24h9v9h-9zM31 40h9v9h-9z" style="fill:var(--accent)"/><path d="M8.5 56h24M12.5 60.5h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- elif n == 3 -%}
<svg aria-hidden="true" viewBox="0 0 120 64"><path d="M29 12h9v9h-9zM42 12h9v9h-9zM55 12h9v9h-9zM68 12h9v9h-9zM81 12h9v9h-9zM29 25h9v9h-9zM42 25h9v9h-9zM55 25h9v9h-9zM68 25h9v9h-9zM81 25h9v9h-9zM29 38h9v9h-9zM42 38h9v9h-9zM55 38h9v9h-9zM68 38h9v9h-9zM81 38h9v9h-9zM29 51h9v9h-9zM42 51h9v9h-9zM55 51h9v9h-9zM68 51h9v9h-9zM81 51h9v9h-9z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M29 8.5V5h61v3.5M1 36h20M16 31l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- elif n == 4 -%}
<svg aria-hidden="true" viewBox="0 0 120 64"><path d="M1 12h9v9h-9zM1 38h9v9h-9zM1 51h9v9h-9z" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="1" y="25" width="9" height="9" style="fill:var(--accent)"/><path d="M15 15h62v3H15zM15 28h46v3H15zM15 41h30v3H15zM15 54h16v3H15z" fill="currentColor"/></svg>
  {%- endif -%}
{%- endmacro -%}

{#- Where to go next, on the home page. The gutter carries the page's name as a tag rather than a date,
    because these rows are addresses and not points in time: a tag is the site's label that is never
    clickable, it takes no tick, and so nothing false is put on the margin rule, which stays a time axis.
    The stylesheet sets a tag in a log's gutter as a small uppercase mono label, not an outlined box -- a
    boxed page name read as a button that does nothing (deep review 2026-09-25, DS-03); the box is the
    paper card's venue badge alone. The link is set like a title, in ink with the accent underline. The
    link is a real thing on the page it leads to -- a paper's title, a course, a speaker -- and the clause
    after the em dash says what else is there. The dash is tied to the label's last word by a no-break
    space, so it never opens a line: with the Teaching label at the course's full name it stood at the
    start of a line on 390-400px phones, and the Research row's did at 430 (deep review 2026-09-25).
    The Research row carries two things more, both drawn from the first paper card (`research[0]`) so
    that nothing is written twice: the paper's first venue badge under the gutter label -- the one
    outlined box outside the card, set in the gutter exactly as the card sets its badges -- and, under
    the line, a small mono row with the card's first button (Paper) and its Code link (deep review
    2026-09-25, DS-09 and AS-02). The links row stands outside .what on purpose: inside it, the title
    rule (.log--go .what a) would set them as two more bold ink titles. Every key is tested before use;
    a card without badges or buttons draws neither. -#}
{%- macro elsewhere_rows(items) %}
{% for item in items %}
        <li class="row">
          <p class="kind"><span class="tag">{{ item.page }}</span></p>
  {% if item.url == "research/" and research and research[0].get("badges") %}
          <p class="go-venue"><span class="tag tag--venue">{{ research[0].badges[0] }}</span></p>
  {% endif %}
          <p class="what"><a href="{{ item.url|local(base) }}">{{ nb(item.label) }}</a>&nbsp;— {{ nb(item.text) }}</p>
  {% if item.url == "research/" and research and research[0].get("badges") %}
    {% set buttons = research[0].get("buttons") or [] %}
    {% set code = buttons|selectattr("label", "equalto", "Code")|list %}
    {% if buttons %}
          <p class="go-links"><a href="{{ buttons[0].url }}">{{ buttons[0].label }}</a>{% if code %} · <a href="{{ code[0].url }}">Code</a>{% endif %}</p>
    {% endif %}
  {% endif %}
        </li>
{% endfor %}
{% endmacro -%}

{#- A teaching post, laid out exactly like a talk: the years in the gutter, his role under them as a tag, the
    course and what it is about in the text column. `what` is optional -- the two rows under "Students" are
    the people, not a syllabus, and have nothing to add under the title. -#}
{%- macro teaching_rows(items) %}
{% for item in items %}
        <li class="row">
          <p class="when">{{ dates(item.when) }}</p>
          <p class="kind"><span class="tag">{{ item.kind }}</span></p>
          <div class="what">
            <h3>{{ nb(item.title) }}</h3>
  {% if item.get("what") %}
            <p>{{ nb(item.what) }}</p>
  {% endif %}
          </div>
        </li>
{% endfor %}
{% endmacro -%}

{#- A news item is one sentence; with `link` and `url` one phrase of it is a link to the thing it names (the
    preprint, the code, the paper's card). The text is split around the phrase and each piece goes through
    nb() on its own, so a no-break term inside the phrase is still wrapped and the address is never touched.
    build.validate() refuses a phrase that is not in the text, so the else branch is only for items without
    a link. -#}
{%- macro news_rows(items) %}
{% for item in items %}
        <li class="row">
          {{ dates(item.date, "when") }}
  {% if item.get("link") and item.get("url") and item.link in item.text %}
    {% set parts = item.text.split(item.link, 1) %}
          <p class="what">{{ nb(parts[0]) }}<a href="{{ item.url|local(base) }}">{{ nb(item.link) }}</a>{{ nb(parts[1]) }}</p>
  {% else %}
          <p class="what">{{ nb(item.text) }}</p>
  {% endif %}
        </li>
{% endfor %}
{% endmacro -%}

{#- A commonplace book: lines he has copied out, on the same time axis as everything else, so the year sits in
    the gutter and takes its tick like a talk. The attribution stands outside the blockquote, as the quoting
    rules ask, and is a paragraph rather than a <cite>, because it opens with a person and <cite> marks the
    title of a work; the note after it is the one sentence of context that tells you where the line falls.
    Each row carries its slug as its id, and the attribution ends on a small "§" that links to it, so one
    line can be shared (deep review 2026-09-25, AS-52). The link is inside the attribution's own paragraph,
    at its end, and it is always painted: a keyboard or a finger cannot hover. build.validate() refuses a
    quotation without a slug, so the key is read directly. The link's accessible name carries the speaker
    (the attribution up to ", in") and the line's first clause (build.opening), so a screen reader's list of
    links tells the four apart; two of the lines are Holmes's, so the speaker alone would not. -#}
{%- macro quote_rows(items) %}
{% for quote in items %}
        <li class="row" id="{{ quote.slug }}">
          {{ dates(quote.year, "when") }}
          <div class="what quote">
            <blockquote><p>{{ nb(quote.text) }}</p></blockquote>
            <p class="quote__by">{{ nb(quote.attribution) }}<a class="quote__link" href="#{{ quote.slug }}" aria-label="Link to this quotation ({{ quote.attribution.split(', in ')[0] }}: “{{ quote.text|opening }}”)">§</a></p>
  {% if quote.get("note") %}
            <p class="quote__note">{{ nb(quote.note) }}</p>
  {% endif %}
          </div>
        </li>
{% endfor %}
{% endmacro -%}
