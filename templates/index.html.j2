  "x": "M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z",
} -%}

{%- macro icon(name) -%}
  {%- if name and ICONS.get(name) -%}
    <svg class="ico" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="{{ ICONS[name] }}"/></svg>
  {%- endif -%}
{%- endmacro -%}

{%- macro authors(names, me) -%}
  {%- for name in names -%}
    {%- if name == me %}<span class="me">{{ name }}</span>{% else %}{{ name }}{% endif -%}
    {%- if not loop.last %}, {% endif -%}
  {%- endfor -%}
{%- endmacro -%}

{%- macro news_rows(items) %}
{% for item in items %}
        <li class="row">
          {{ dates(item.date, "when") }}
          <p class="what">{{ nb(item.text) }}</p>
        </li>
{% endfor %}
{% endmacro -%}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.name }}</title>
<meta name="description" content="{{ site.identity_line }}">
<link rel="canonical" href="{{ site.site_url }}">
<meta property="og:title" content="{{ site.name }}">
<meta property="og:description" content="{{ site.identity_line }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.site_url }}">
<meta property="og:image" content="{{ site.site_url }}img/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }}. {{ site.identity_line }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2042%2010'%3E%3Cstyle%3Ecircle%7Bfill:%2314212B%7Drect%7Bfill:%230B5F73%7D@media%20(prefers-color-scheme:dark)%7Bcircle%7Bfill:%23E4EBEF%7Drect%7Bfill:%236DB3C4%7D%7D%3C/style%3E%3Ccircle%20cx='5'%20cy='5'%20r='5'/%3E%3Ccircle%20cx='21'%20cy='5'%20r='5'/%3E%3Crect%20x='32'%20width='10'%20height='10'/%3E%3C/svg%3E">
<script>
/* Theme toggle. Follows the system setting until the visitor chooses; the choice is remembered. */
(function () {
  var root = document.documentElement, KEY = "theme";
  var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  try {
    var saved = localStorage.getItem(KEY);
    if (saved === "light" || saved === "dark") root.setAttribute("data-theme", saved);
  } catch (e) {}
  function current() {
    return root.getAttribute("data-theme") || (mq && mq.matches ? "dark" : "light");
  }
  document.addEventListener("DOMContentLoaded", function () {
    /* The address stays written as "name [at] host" in the markup; the link is built from that text here. */
    var em = document.getElementById("email");
    if (em) {
      var a = document.createElement("a");
      a.id = "email";
      a.textContent = em.textContent;
      a.href = "mailto:" + em.textContent.replace(" [at] ", "@");
      em.parentNode.replaceChild(a, em);
    }

    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var label = btn.querySelector("span");
    function paint() { label.textContent = "Use " + (current() === "dark" ? "light" : "dark") + " theme"; }
    btn.hidden = false;
    paint();
    btn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem(KEY, next); } catch (e) {}
      paint();
    });
    if (mq && mq.addEventListener) mq.addEventListener("change", paint);
  });
})();
</script>
<link rel="stylesheet" href="style.css">
<script type="application/ld+json">{{ jsonld|safe }}</script>
</head>
<body>
<div class="page">

  <header>
    <div class="topbar">
      <button id="theme-toggle" class="toggle" type="button" hidden>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
        <span>Use dark theme</span>
      </button>
    </div>

    <div class="masthead">
      <picture><source srcset="{{ site.portrait.webp }}" type="image/webp"><img src="{{ site.portrait.jpg }}" width="120" height="120" alt="{{ site.portrait.alt }}"></picture>
      <h1>{{ site.name }}</h1>
{% if site.get("role") %}
      <ul class="role" role="list">
  {% for item in site.role %}
        <li>{% if item.get("url") %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}</li>
  {% endfor %}
      </ul>
{% endif %}
      <p class="lede">{{ site.identity_line }}</p>
{# Two rows: how to reach him, then where else he is. Split because the profiles line up in columns of their
   own when the page is narrow, which the address is too long to join. #}
      <nav class="links-nav" aria-label="Contact and profiles">
        <ul class="links links--reach" role="list">
{# The CV button leads the row and is its only filled element; it appears once show_cv is switched on. #}
{% for link in site.links if link.label == "CV" and site.show_cv %}
          <li><a class="btn btn--primary" href="{{ link.url }}">{{ link.label }}</a></li>
{% endfor %}
{% for link in site.links if link.label == "Email" and link.get("text") %}
          <li class="links__email"><span class="links__label">{{ icon(link.get("icon")) }}{{ link.label }}</span> <span id="email">{{ link.text }}</span></li>
{% endfor %}
        </ul>
        <ul class="links links--profiles" role="list">
{% for link in site.links if link.label not in ("CV", "Email") and link.get("url") %}
          <li><a rel="me" href="{{ link.url }}">{{ icon(link.get("icon")) }}<span>{{ link.label }}</span></a></li>
{% endfor %}
        </ul>
      </nav>
      <div class="bio">
{% for paragraph in site.bio %}
        <p>{{ nb(paragraph) }}</p>
{% endfor %}
      </div>
    </div>
  </header>

  <main>

    <section id="research" aria-labelledby="research-h">
      <h2 id="research-h" class="inset">Research</h2>
{% for card in research %}
      <article class="paper">
        <div class="paper__aside">
          <ul class="paper__badges" role="list" aria-label="Venues">
{# accent = a publication venue; neutral = a presentation ("CCN 2025 · Talk") or a status #}
  {% for badge in card.get("badges") or [] %}
            <li><span class="tag{{ "" if " · " in badge else " tag--venue" }}">{{ badge }}</span></li>
  {% endfor %}
  {% if card.get("ongoing") %}
            <li><span class="tag">Ongoing</span></li>
  {% endif %}
          </ul>
{# A figure carries a webp when one was made, and "invert: true" only when it is line work on white that the
   dark theme may turn inside out. A caption appears when it says something the picture does not. #}
  {% if card.get("figure") %}
          <figure class="paper__fig{{ " paper__fig--invert" if card.figure.get("invert") else "" }}">
            <span class="paper__plot">
    {% if card.figure.get("webp") %}
              <picture><source srcset="{{ card.figure.webp }}" type="image/webp"><img src="{{ card.figure.src }}" alt="{{ card.figure.alt }}" width="272" height="272"></picture>
    {% else %}
              <img src="{{ card.figure.src }}" alt="{{ card.figure.alt }}" width="272" height="272">
    {% endif %}
            </span>
    {% if card.figure.get("caption") %}
            <figcaption>{{ card.figure.caption }}</figcaption>
    {% endif %}
          </figure>
  {% endif %}
        </div>
        <div class="paper__body">
          <h3>{{ nb(card.title) }}</h3>
  {% if card.get("authors") %}
          <p class="authors">{{ authors(card.authors, card.get("me") or site.name) }}</p>
  {% endif %}
          <p class="tldr"><span class="runin">Summary</span> {{ nb(card.tldr) }}</p>
          <ul class="buttons" role="list">
  {% for button in card.get("buttons") or [] %}
            <li><a class="btn{{ " btn--primary" if loop.first else "" }}" href="{{ button.url }}">{{ button.label }}</a></li>
  {% endfor %}
          </ul>
        </div>
      </article>
{% endfor %}
    </section>

    <section id="news" aria-labelledby="news-h">
      <h2 id="news-h" class="inset">News</h2>
      <ul class="log log--tight" role="list">
        {{ news_rows(news_shown)|trim }}
      </ul>
{% if news_older %}
      <details class="older">
        <summary><span>Older news ({{ news_older|length }})</span></summary>
        <ul class="log log--tight" role="list">
          {{ news_rows(news_older)|trim }}
        </ul>
      </details>
{% endif %}
    </section>

    <section id="talks" aria-labelledby="talks-h">
      <h2 id="talks-h" class="inset">Talks</h2>
      <ul class="log log--talks" role="list">
{% for talk in site.talks %}
        <li class="row">
          <p class="when">{{ dates(talk.date) }}</p>
          <p class="kind"><span class="tag">{{ talk.kind }}</span></p>
          <div class="what">
            <h3>{{ nb(talk.title) }}</h3>
  {% if talk.get("authors") %}
            <p class="authors">{{ authors(talk.authors, site.name) }}</p>
  {% endif %}
            <p class="venue">{% if talk.get("url") %}<a href="{{ talk.url }}">{{ nb(talk.venue) }}</a>{% else %}{{ nb(talk.venue) }}{% endif %}<span class="vh">, </span><span class="place">{{ talk.place }}</span></p>
  {% if talk.get("note") %}
            <p class="note">{{ talk.note }}</p>
  {% endif %}
          </div>
        </li>
{% endfor %}
      </ul>
    </section>

    <section id="projects" aria-labelledby="projects-h">
      <h2 id="projects-h" class="inset">Projects</h2>
      <ul class="log" role="list">
{% for project in site.projects %}
        <li class="row">
          <p class="when">{{ dates(project.period) }}</p>
          <div class="what">
            <h3>{% if project.get("url") %}<a href="{{ project.url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</h3>
            <p>{{ nb(project.blurb) }}</p>
          </div>
        </li>
{% endfor %}
      </ul>
    </section>

{# Lines he has copied out, on the same time axis as everything else: the year sits in the gutter and takes its
   tick, so a quotation is dated like a talk. The attribution stands outside the blockquote, as the quoting
   rules ask; the note after it is the one sentence of context that tells you where the line falls. #}
{% if site.get("quotes") %}
    <section id="quotes" aria-labelledby="quotes-h">
      <h2 id="quotes-h" class="inset">Quotes</h2>
      <ul class="log" role="list">
  {% for quote in site.quotes %}
        <li class="row">
          {{ dates(quote.year, "when") }}
          <div class="what quote">
            <blockquote><p>{{ nb(quote.text) }}</p></blockquote>
            <p class="quote__by"><cite>{{ nb(quote.attribution) }}</cite></p>
    {% if quote.get("note") %}
            <p class="quote__note">{{ nb(quote.note) }}</p>
    {% endif %}
          </div>
        </li>
  {% endfor %}
      </ul>
    </section>
{% endif %}

    <section id="teaching" aria-labelledby="teaching-h">
      <h2 id="teaching-h" class="inset">Teaching</h2>
{# Each line is one sentence from site.yaml, kept whole and in order in the markup. When it ends in ": <dates>." the
   layout lifts the dates into the gutter; the colon and the full stop are then visually hidden, because the grid
   does their job. A sentence that does not end in a date ("Mentoring: two ... students.") is left as it is. #}
      <ul class="log log--tight log--said" role="list">
{% for line in site.teaching %}
  {% set what, colon, tail = line.rpartition(": ") %}
  {% set when = tail[:-1] %}
        <li class="row">
  {% if what and tail.endswith(".") and when and when[-1] in "0123456789" %}
          <p class="what">{{ nb(what) }}<span class="vh">: </span></p>
          <p class="when">{{ dates(when) }}<span class="vh">.</span></p>
  {% else %}
          <p class="what">{{ nb(line) }}</p>
  {% endif %}
        </li>
{% endfor %}
      </ul>
    </section>

  </main>

  <footer class="colophon">
    <p class="row"><span class="when">Last updated</span> {{ dates(site.footer.updated, "what") }}</p>
    <svg class="mark inset" aria-hidden="true" viewBox="0 0 42 10" width="42" height="10"><circle cx="5" cy="5" r="5"/><circle cx="21" cy="5" r="5"/><rect x="32" width="10" height="10"/></svg>
  </footer>

</div>
</body>
</html>
