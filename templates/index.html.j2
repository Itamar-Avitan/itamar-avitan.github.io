{#- The D2 "lab notebook" page. Every word on it comes from site.yaml; this file holds markup only.
    Optional keys (url, note, text, ongoing, authors, figure, me, role, nobreak) are tested before use,
    because the build renders with StrictUndefined. -#}

{#- Wrap the no-break terms listed in site.yaml; the text is escaped first, so content can never inject markup. -#}
{%- macro nb(text) -%}
  {%- set ns = namespace(out=text) -%}
  {%- for term in site.get("nobreak") or [] -%}
    {%- set ns.out = ns.out|replace(term, ('<span class="nb">'|safe) ~ term ~ ('</span>'|safe)) -%}
  {%- endfor -%}
  {{- ns.out -}}
{%- endmacro -%}

{%- set MONTHS = {"Jan": "01", "Feb": "02", "Mar": "03", "Apr": "04", "May": "05", "Jun": "06",
                  "Jul": "07", "Aug": "08", "Sep": "09", "Oct": "10", "Nov": "11", "Dec": "12"} -%}

{#- The machine-readable form of ["2026"], ["Sep", "2026"] or ["14", "Sep", "2026"]; empty when it cannot be read. -#}
{%- macro iso(words) -%}
  {%- set year = words[-1] -%}
  {%- set month = MONTHS.get(words[-2][:3]) if words|length > 1 else none -%}
  {%- set day = words[0]|int(0) if words|length == 3 else 0 -%}
  {%- if year|length == 4 and year|int(0) >= 1000 -%}
    {%- if words|length == 1 -%}
      {{- year -}}
    {%- elif words|length == 2 and month -%}
      {{- year }}-{{ month -}}
    {%- elif words|length == 3 and month and 1 <= day <= 31 -%}
      {{- year }}-{{ month }}-{{ "%02d"|format(day) -}}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{#- A date or a range of two dates as <time> elements. The left side of a range borrows the words it leaves out from
    the right side: "14–15 Sep 2026", "24 Jul–6 Aug 2026", "2022–2023". Anything else stays plain text.
    With cls the result is one element carrying that class (a row's "when" or "what"). -#}
{%- macro dates(text, cls=none) -%}
  {%- set sides = text.split("–") -%}
  {%- set last = sides[-1].split(" ") -%}
  {%- set ns = namespace(stamps=[]) -%}
  {%- for side in sides -%}
    {%- set own = side.split(" ") -%}
    {%- set ns.stamps = ns.stamps + [iso(own + last[own|length:])] -%}
  {%- endfor -%}
  {%- set readable = sides|length <= 2 and "" not in ns.stamps -%}
  {%- if readable and cls and sides|length == 1 -%}
    <time class="{{ cls }}" datetime="{{ ns.stamps[0] }}">{{ text }}</time>
  {%- else -%}
    {%- if cls %}<span class="{{ cls }}">{% endif -%}
    {%- if readable -%}
      {%- for side in sides -%}
        <time datetime="{{ ns.stamps[loop.index0] }}">{{ side }}</time>{% if not loop.last %}–{% endif -%}
      {%- endfor -%}
    {%- else -%}
      {{- text -}}
    {%- endif -%}
    {%- if cls %}</span>{% endif -%}
  {%- endif -%}
{%- endmacro -%}

{#- The marks drawn before a link label, chosen by each link's "icon" key in site.yaml. One 16px solid shape
    each, one colour (fill: currentColor), and aria-hidden: the text label beside a mark is its accessible name,
    so the mark itself says nothing twice. They are inline, so the page still asks no other host for anything.

    THREE MARKS, AND ONLY THREE. The owner ruled on 2026-09-21 that this page draws a mark for Email, GitHub
    and Bluesky and for nothing else. Four were deleted that day and must not be put back:
      linkedin -- Simple Icons removed the LinkedIn mark on 2024-12-17 because LinkedIn's brand policy forbids
                  third-party use of the logo. There is no licensed file left to ship.
      orcid    -- ORCID's terms say the iD icon "must be used as provided, and must not be changed or altered
                  in any way". What stood here was a recoloured trace laid out at 12.4 CSS px, under ORCID's
                  documented 16px floor: altered twice over.
      scholar  -- the stand-in mortarboard closed into a blob below about 20px, and Google asks that its
                  product icons not be imitated, so there was no truer mark to reach for instead.
      x        -- X's brand terms could not be fetched, so permission could not be established at all.
    A missing mark here is not a bug to fix: those four links carry their text label, which is what says where
    they go. See the note above "links" in site.yaml, and the safe-subset test in tests/test_build.py.

    Licences and provenance of the three that remain: "mail" is drawn here, so no third party's terms apply to
    it -- it is an envelope, not anyone's brand. "github" and "bluesky" are the marks published by Simple Icons
    16.32.0 (CC0-1.0, https://github.com/simple-icons/simple-icons). CC0 asks for no attribution; it is
    recorded here because a brand mark is a trademark whatever its file licence says. Each is used unaltered
    and only as a link to the owner's own page -- the use both brand guides allow. Their colour rules ask for
    black or white; these follow the page instead, in the grey of its dates and labels, which is the one point
    where this falls short of the letter of the guides. -#}
{%- set ICONS = {
  "mail": "M4 4.5h16a2 2 0 0 1 2 2v.3l-10 6.1L2 6.8v-.3a2 2 0 0 1 2-2zM2 8.55v8.95a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.55l-9.48 5.78a1 1 0 0 1-1.04 0z",
  "github": "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  "bluesky": "M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026",
} -%}

{#- Each mark also carries its own class, because the three marks fill their 24x24 box very differently: the
    stylesheet sizes them one by one so they read as one set rather than as three weights. -#}
{%- macro icon(name) -%}
  {%- if name and ICONS.get(name) -%}
    <svg class="ico ico--{{ name }}" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="{{ ICONS[name] }}"/></svg>
  {%- endif -%}
{%- endmacro -%}

{%- macro authors(names, me) -%}
  {%- for name in names -%}
    {%- if name == me %}<span class="me">{{ name }}</span>{% else %}{{ name }}{% endif -%}
    {%- if not loop.last %}, {% endif -%}
  {%- endfor -%}
{%- endmacro -%}

{%- macro news_rows(items) %}
{% for item in items %}
        <li class="row">
          {{ dates(item.date, "when") }}
          <p class="what">{{ nb(item.text) }}</p>
        </li>
{% endfor %}
{% endmacro -%}

{%- macro quote_rows(items) %}
{% for quote in items %}
        <li class="row">
          {{ dates(quote.year, "when") }}
          <div class="what quote">
            <blockquote><p>{{ nb(quote.text) }}</p></blockquote>
            <p class="quote__by">{{ nb(quote.attribution) }}</p>
  {% if quote.get("note") %}
            <p class="quote__note">{{ nb(quote.note) }}</p>
  {% endif %}
          </div>
        </li>
{% endfor %}
{% endmacro -%}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.name }}</title>
<meta name="description" content="{{ site.identity_line }}">
<link rel="canonical" href="{{ site.site_url }}">
<meta property="og:title" content="{{ site.name }}">
<meta property="og:description" content="{{ site.identity_line }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.site_url }}">
<meta property="og:image" content="{{ site.site_url }}img/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }}. {{ site.identity_line }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2042%2010'%3E%3Cstyle%3Ecircle%7Bfill:%2314212B%7Drect%7Bfill:%230B5F73%7D@media%20(prefers-color-scheme:dark)%7Bcircle%7Bfill:%23E4EBEF%7Drect%7Bfill:%236DB3C4%7D%7D%3C/style%3E%3Ccircle%20cx='5'%20cy='5'%20r='5'/%3E%3Ccircle%20cx='21'%20cy='5'%20r='5'/%3E%3Crect%20x='32'%20width='10'%20height='10'/%3E%3C/svg%3E">
<script>
/* Theme toggle. Follows the system setting until the visitor chooses; the choice is remembered. */
(function () {
  var root = document.documentElement, KEY = "theme";
  var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  try {
    var saved = localStorage.getItem(KEY);
    if (saved === "light" || saved === "dark") root.setAttribute("data-theme", saved);
  } catch (e) {}
  function current() {
    return root.getAttribute("data-theme") || (mq && mq.matches ? "dark" : "light");
  }
  document.addEventListener("DOMContentLoaded", function () {
    /* The address stays written as "name [at] host" in the markup; the link is built from that text here. */
    var em = document.getElementById("email");
    if (em) {
      var a = document.createElement("a");
      a.id = "email";
      a.textContent = em.textContent;
      a.href = "mailto:" + em.textContent.replace(" [at] ", "@");
      em.parentNode.replaceChild(a, em);
    }

    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var label = btn.querySelector("span");
    function paint() { label.textContent = "Use " + (current() === "dark" ? "light" : "dark") + " theme"; }
    btn.hidden = false;
    paint();
    btn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem(KEY, next); } catch (e) {}
      paint();
    });
    if (mq && mq.addEventListener) mq.addEventListener("change", paint);
  });
})();
</script>
<link rel="stylesheet" href="style.css">
<script type="application/ld+json">{{ jsonld|safe }}</script>
</head>
<body>
<div class="page">

  <header>
    <div class="topbar">
      <button id="theme-toggle" class="toggle" type="button" hidden>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
        <span>Use dark theme</span>
      </button>
    </div>

    <div class="masthead">
      <picture><source srcset="{{ site.portrait.webp }}" type="image/webp"><img src="{{ site.portrait.jpg }}" width="120" height="120" alt="{{ site.portrait.alt }}"></picture>
      <h1>{{ site.name }}</h1>
{% if site.get("role") %}
      <ul class="role" role="list">
  {% for item in site.role %}
        <li>{% if item.get("url") %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}</li>
  {% endfor %}
      </ul>
{% endif %}
      <p class="lede">{{ site.identity_line }}</p>
{# Three lists, in this order: how to reach him, the profiles this page may mark, the profiles it may not.
   The split is the answer to a design problem, not a ranking. Only three of the seven destinations allow
   their mark to be drawn here (see the note over ICONS), and a row in which three items out of seven carry
   one, scattered, looks like four icons failed to load. Listing the marked ones first puts the marks side by
   side, which is what settles that; the stylesheet then sets one step between every pair of links, marked or
   plain, because a wider step between the two lists read at desktop width as a missing item rather than as
   two groups. The lists stay separate so that they wrap as whole groups. The envelope on the address above
   them gives the block a mark on its first line as well, so the left edge is the same shape all the way down. #}
      <nav class="links-nav" aria-label="Contact and profiles">
        <ul class="links links--reach" role="list">
{# The CV button leads the row and is its only filled element; it appears once show_cv is switched on. #}
{% for link in site.links if link.label == "CV" and site.show_cv %}
          <li><a class="btn btn--primary" href="{{ link.url }}">{{ link.label }}</a></li>
{% endfor %}
{% for link in site.links if link.label == "Email" and link.get("text") %}
          <li class="links__email"><span class="links__label">{{ icon(link.get("icon")) }}{{ link.label }}</span> <span id="email">{{ link.text }}</span></li>
{% endfor %}
        </ul>
        <div class="links-row">
          <ul class="links links--marked" role="list">
{% for link in site.links if link.label not in ("CV", "Email") and link.get("url") and link.get("icon") %}
            <li><a rel="me" href="{{ link.url }}">{{ icon(link.icon) }}<span>{{ link.label }}</span></a></li>
{% endfor %}
          </ul>
          <ul class="links links--plain" role="list">
{% for link in site.links if link.label not in ("CV", "Email") and link.get("url") and not link.get("icon") %}
            <li><a rel="me" href="{{ link.url }}"><span>{{ link.label }}</span></a></li>
{% endfor %}
          </ul>
        </div>
      </nav>
      <div class="bio">
{% for paragraph in site.bio %}
        <p>{{ nb(paragraph) }}</p>
{% endfor %}
      </div>
    </div>
  </header>

  <main>

    <section id="research" aria-labelledby="research-h">
      <h2 id="research-h" class="inset">Research</h2>
{% for card in research %}
      <article class="paper">
        <div class="paper__aside">
          <ul class="paper__badges" role="list" aria-label="Venues">
{# accent = a publication venue; neutral = a presentation ("CCN 2025 · Talk") or a status #}
  {% for badge in card.get("badges") or [] %}
            <li><span class="tag{{ "" if " · " in badge else " tag--venue" }}">{{ badge }}</span></li>
  {% endfor %}
  {% if card.get("ongoing") %}
            <li><span class="tag">Ongoing</span></li>
  {% endif %}
          </ul>
{# A figure carries a webp when one was made, and "plot: true" when its colour is data and must keep its hues.
   A caption appears when it says something the picture does not. #}
  {% if card.get("figure") %}
          <figure class="paper__fig {{ "paper__fig--plot" if card.figure.get("plot") else "paper__fig--art" }}">
            <span class="paper__plot">
    {% if card.figure.get("webp") %}
              <picture><source srcset="{{ card.figure.webp }}" type="image/webp"><img src="{{ card.figure.src }}" alt="{{ card.figure.alt }}" width="272" height="272"></picture>
    {% else %}
              <img src="{{ card.figure.src }}" alt="{{ card.figure.alt }}" width="272" height="272">
    {% endif %}
            </span>
    {% if card.figure.get("caption") %}
            <figcaption>{{ card.figure.caption }}</figcaption>
    {% endif %}
          </figure>
  {% endif %}
        </div>
        <div class="paper__body">
          <h3>{{ nb(card.title) }}</h3>
  {% if card.get("authors") %}
          <p class="authors">{{ authors(card.authors, card.get("me") or site.name) }}</p>
  {% endif %}
          <p class="tldr"><span class="runin">Summary</span> {{ nb(card.tldr) }}</p>
          <ul class="buttons" role="list">
  {% for button in card.get("buttons") or [] %}
            <li><a class="btn{{ " btn--primary" if loop.first else "" }}" href="{{ button.url }}">{{ button.label }}</a></li>
  {% endfor %}
          </ul>
        </div>
      </article>
{% endfor %}
    </section>

    <section id="news" aria-labelledby="news-h">
      <h2 id="news-h" class="inset">News</h2>
      <ul class="log log--tight" role="list">
        {{ news_rows(news_shown)|trim }}
      </ul>
{% if news_older %}
      <details class="older">
        <summary><span>Older news ({{ news_older|length }})</span></summary>
        <ul class="log log--tight" role="list">
          {{ news_rows(news_older)|trim }}
        </ul>
      </details>
{% endif %}
    </section>

    <section id="talks" aria-labelledby="talks-h">
      <h2 id="talks-h" class="inset">Talks</h2>
      <ul class="log log--talks" role="list">
{% for talk in site.talks %}
        <li class="row">
          <p class="when">{{ dates(talk.date) }}</p>
          <p class="kind"><span class="tag">{{ talk.kind }}</span></p>
          <div class="what">
            <h3>{{ nb(talk.title) }}</h3>
  {% if talk.get("authors") %}
            <p class="authors">{{ authors(talk.authors, site.name) }}</p>
  {% endif %}
            <p class="venue">{% if talk.get("url") %}<a href="{{ talk.url }}">{{ nb(talk.venue) }}</a>{% else %}{{ nb(talk.venue) }}{% endif %}<span class="vh">, </span><span class="place">{{ talk.place }}</span></p>
  {% if talk.get("note") %}
            <p class="note">{{ talk.note }}</p>
  {% endif %}
          </div>
        </li>
{% endfor %}
      </ul>
    </section>

    <section id="projects" aria-labelledby="projects-h">
      <h2 id="projects-h" class="inset">Projects</h2>
      <ul class="log" role="list">
{% for project in site.projects %}
        <li class="row">
          <p class="when">{{ dates(project.period) }}</p>
          <div class="what">
            <h3>{% if project.get("url") %}<a href="{{ project.url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</h3>
            <p>{{ nb(project.blurb) }}</p>
          </div>
        </li>
{% endfor %}
      </ul>
    </section>

{# A commonplace book: lines he has copied out, on the same time axis as everything else, so the year sits in
   the gutter and takes its tick like a talk. The attribution stands outside the blockquote, as the quoting
   rules ask, and is a paragraph rather than a <cite>, because it opens with a person and <cite> marks the
   title of a work; the note after it is the one sentence of context that tells you where the line falls. #}
{% if site.get("quotes") %}
    <section id="quotes" aria-labelledby="quotes-h">
      <h2 id="quotes-h" class="inset">Commonplace</h2>
  {% if site.get("quotes_intro") %}
      <p class="section-note inset">{{ nb(site.quotes_intro) }}</p>
  {% endif %}
{# The same expander as "Older news", and it holds the same thing: the older end of the list. It stands above
   the lines rather than below them because this list runs the other way -- news is newest first, a
   commonplace book is read forwards, 1887 before 2003 -- so opening it must add its entries at the top, or
   the gutter's dates would run backwards. Not a quotation was cut to get here: all four are still on the
   page, two of them one click away. #}
  {% if quotes_older %}
      <details class="older older--first">
        <summary><span>Older lines ({{ quotes_older|length }})</span></summary>
        <ul class="log log--quotes" role="list">
          {{ quote_rows(quotes_older)|trim }}
        </ul>
      </details>
  {% endif %}
      <ul class="log log--quotes" role="list">
        {{ quote_rows(quotes_shown)|trim }}
      </ul>
    </section>
{% endif %}

    <section id="teaching" aria-labelledby="teaching-h">
      <h2 id="teaching-h" class="inset">Teaching</h2>
{# Each line is one sentence from site.yaml, kept whole and in order in the markup. When it ends in ": <dates>." the
   layout lifts the dates into the gutter; the colon and the full stop are then visually hidden, because the grid
   does their job. A sentence that does not end in a date ("Mentoring: two ... students.") is left as it is. #}
      <ul class="log log--tight log--said" role="list">
{% for line in site.teaching %}
  {% set what, colon, tail = line.rpartition(": ") %}
  {% set when = tail[:-1] %}
        <li class="row">
  {% if what and tail.endswith(".") and when and when[-1] in "0123456789" %}
          <p class="what">{{ nb(what) }}<span class="vh">: </span></p>
          <p class="when">{{ dates(when) }}<span class="vh">.</span></p>
  {% else %}
          <p class="what">{{ nb(line) }}</p>
  {% endif %}
        </li>
{% endfor %}
      </ul>
    </section>

  </main>

  <footer class="colophon">
    <p class="row"><span class="when">Last updated</span> {{ dates(site.footer.updated, "what") }}</p>
    <svg class="mark inset" aria-hidden="true" viewBox="0 0 42 10" width="42" height="10"><circle cx="5" cy="5" r="5"/><circle cx="21" cy="5" r="5"/><rect x="32" width="10" height="10"/></svg>
  </footer>

</div>
</body>
</html>
