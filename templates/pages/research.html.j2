{#- Research: the question, the paper, the talks and posters around it, and the things built in teams. -#}
{% extends "base.html.j2" %}

{% block main %}

    <section id="research" aria-labelledby="research-h">
      <h1 id="research-h" class="inset">{{ page.heading }}</h1>
{% if page.get("intro") %}
      <p class="page-intro inset">{{ m.nb(page.intro) }}</p>
{% endif %}
    </section>

{# The paper had no heading of its own, so the page read h1 Research -> [card] -> h2 Talks -> h2 Projects:
   two of the three things it holds took a tick on the margin rule and the third did not, which left the card
   looking like an illustration of the intro rather than the work itself. It also skipped a heading level --
   the card's title is an h3 and there was no h2 above it. Both are answered by naming the section. #}
    <section id="papers" aria-labelledby="papers-h">
      <h2 id="papers-h" class="inset">Papers</h2>
{% for card in research %}
      <article class="paper">
        <div class="paper__aside">
          <ul class="paper__badges" role="list" aria-label="Venues">
{# accent = a publication venue; neutral = a presentation ("CCN 2025 · Talk") or a status #}
  {% for badge in card.get("badges") or [] %}
            <li><span class="tag{{ "" if " · " in badge else " tag--venue" }}">{{ badge }}</span></li>
  {% endfor %}
  {% if card.get("ongoing") %}
            <li><span class="tag">Ongoing</span></li>
  {% endif %}
          </ul>
{# A figure carries a webp when one was made, and "plot: true" when its colour is data and must keep its hues.
   A caption appears when it says something the picture does not. #}
  {% if card.get("figure") %}
          <figure class="paper__fig {{ "paper__fig--plot" if card.figure.get("plot") else "paper__fig--art" }}">
            <span class="paper__plot">
    {% if card.figure.get("webp") %}
              <picture><source srcset="{{ card.figure.webp|local(base) }}" type="image/webp"><img src="{{ card.figure.src|local(base) }}" alt="{{ card.figure.alt }}" width="272" height="272"></picture>
    {% else %}
              <img src="{{ card.figure.src|local(base) }}" alt="{{ card.figure.alt }}" width="272" height="272">
    {% endif %}
            </span>
    {% if card.figure.get("caption") %}
            <figcaption>{{ card.figure.caption }}</figcaption>
    {% endif %}
          </figure>
  {% endif %}
        </div>
{# The body runs in a citation's order: what it is, who wrote it, where it appeared, where to get it, then
   the argument. The title is the card's primary link, to the first button's address (the paper): a title that
   is not a link is the one thing on the card a reader tries first. The links stand above the argument on every
   width because they are why most readers arrive; below it they sat under the fold on the commonest laptop. #}
        <div class="paper__body">
          <h3>{% if card.get("buttons") %}<a href="{{ card.buttons[0].url }}">{{ m.nb(card.title) }}</a>{% else %}{{ m.nb(card.title) }}{% endif %}</h3>
  {% if card.get("authors") %}
          <p class="authors">{{ m.authors(card.authors, card.get("me") or site.name) }}</p>
  {% endif %}
  {% if card.get("venue") %}
          <p class="venue paper__venue">{{ m.nb(card.venue) }}</p>
  {% endif %}
{# A button's optional `context` (site.yaml) follows its label in a hidden span, so a screen reader's list of
   links says "Paper (NeurIPS 2025)" and "Code for the NeurIPS 2025 paper" where the eye reads the card
   around the word (deep review 2026-09-25, PA-05). Per button, from site.yaml, because one suffix for all of
   them would call the CCN recording part of the NeurIPS paper, which the ruling forbids.
   The links are grouped by what a reader does with them (controller decision C4 under owner ruling 18,
   2026-09-26; external review 3 §23): `uses` in site.yaml names the groups in order -- Read, Reproduce,
   Watch -- and each button its group, so the card prints three labelled rows rather than one string of
   five. The label of each row is plain text before its list, in the register of the run-in labels below;
   the buttons keep their one style, the first of the card filled as the primary link. The outer list is
   labelled "Resources" for a reader moving by lists; the whole is one macro-less block because only this
   card carries it. A card without `uses` prints the flat row it used to. build.py refuses a button whose
   `use` names no group; a card without buttons draws no list at all. #}
  {% if card.get("uses") and card.get("buttons") %}
          <ul class="buttons buttons--grouped" role="list" aria-label="Resources">
    {% for use in card.uses %}
      {% set group = (card.get("buttons") or []) | selectattr("use", "defined") | selectattr("use", "equalto", use.key) | list %}
      {% if group %}
            <li class="buttons__group"><span class="buttons__use">{{ use.label }}</span>
              <ul class="buttons" role="list">
        {% for button in group %}
                <li><a class="btn{{ " btn--primary" if button is sameas card.buttons[0] else "" }}" href="{{ button.url }}">{{ button.label }}{% if button.get("context") %}<span class="vh"> {{ button.context }}</span>{% endif %}</a></li>
        {% endfor %}
              </ul>
            </li>
      {% endif %}
    {% endfor %}
          </ul>
  {% elif card.get("buttons") %}
          <ul class="buttons" role="list">
    {% for button in card.buttons %}
            <li><a class="btn{{ " btn--primary" if loop.first else "" }}" href="{{ button.url }}">{{ button.label }}{% if button.get("context") %}<span class="vh"> {{ button.context }}</span>{% endif %}</a></li>
    {% endfor %}
          </ul>
  {% endif %}
{# The card as an argument (controller decision C4 under owner ruling 18, 2026-09-26; external review 3 §23):
   five run-in blocks -- Question, Setup, Test, Result, Scope -- each one paragraph of `argument` in
   site.yaml, where every clause is traced to the paper. The owner's diagram (ruling 3) stands under Test and
   illustrates Setup and Test: four marks, each captioned by one of `how`'s stages with a visible counter, so
   the captions are the labels. Then what the paper leaves open, and the citation behind an expander. Only
   the paper card carries these keys; a card without them renders as it did. The list of stages is an
   ordered list with role="list", as every list on the site declares itself once its markers are gone. #}
  {% set argument = card.get("argument") or {} %}
  {% for key, label in [("question", "Question"), ("setup", "Setup"), ("test", "Test")] if argument.get(key) %}
          <p class="tldr"><span class="runin">{{ label }}</span> {{ m.nb(argument[key]) }}</p>
  {% endfor %}
  {% if card.get("how") %}
          <ol class="recovery-diagram" role="list" aria-label="How the model-recovery test works">
    {% for step in card.how %}
            <li>{{ m.recovery_mark(loop.index) }}<p>{{ m.nb(step) }}</p></li>
    {% endfor %}
          </ol>
  {% endif %}
  {% for key, label in [("result", "Result"), ("scope", "Scope")] if argument.get(key) %}
          <p class="tldr"><span class="runin">{{ label }}</span> {{ m.nb(argument[key]) }}</p>
  {% endfor %}
  {% if card.get("open") %}
          <p class="tldr"><span class="runin">Questions the paper leaves open</span></p>
          <ul class="open" role="list">{% for q in card.open %}<li>{{ m.nb(q) }}</li>{% endfor %}</ul>
  {% endif %}
  {% if card.get("cite") %}
          <details class="cite"><summary>Cite (BibTeX)</summary><pre>{{ card.cite }}</pre></details>
  {% endif %}
        </div>
      </article>
{% endfor %}
    </section>

{# "Talks and presentations", the CVs' own heading: the list holds a flash talk, a poster and a contributed
   talk with its poster, so "Talks" alone misfiled the poster. A row's optional `links` (a recording, a
   repository) render under it in the paper card's own button style; the projects list uses the same rule. #}
    <section id="talks" aria-labelledby="talks-h">
      <h2 id="talks-h" class="inset">Talks and presentations</h2>
      <ul class="log log--kind" role="list">
{% for talk in site.talks %}
        <li class="row">
          <p class="when">{{ m.dates(talk.date) }}</p>
          <p class="kind"><span class="tag">{{ talk.kind }}</span></p>
          <div class="what">
            <h3>{{ m.nb(talk.title) }}</h3>
  {% if talk.get("authors") %}
            <p class="authors">{{ m.authors(talk.authors, site.name) }}</p>
  {% endif %}
            <p class="venue">{% if talk.get("url") %}<a href="{{ talk.url }}">{{ m.nb(talk.venue) }}</a>{% else %}{{ m.nb(talk.venue) }}{% endif %}<span class="vh">, </span><span class="place">{{ talk.place }}</span></p>
  {% if talk.get("note") %}
            <p class="note">{{ talk.note }}</p>
  {% endif %}
  {% if talk.get("links") %}
            <ul class="buttons" role="list">{% for link in talk.links %}<li><a class="btn" href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}</ul>
  {% endif %}
          </div>
        </li>
{% endfor %}
      </ul>
    </section>

    <section id="projects" aria-labelledby="projects-h">
      <h2 id="projects-h" class="inset">Projects</h2>
      <ul class="log" role="list">
{% for project in site.projects %}
        <li class="row">
          <p class="when">{{ m.dates(project.period) }}</p>
          <div class="what">
            <h3>{% if project.get("url") %}<a href="{{ project.url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</h3>
            <p>{{ m.nb(project.blurb) }}</p>
  {% if project.get("links") %}
            <ul class="buttons" role="list">{% for link in project.links %}<li><a class="btn" href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}</ul>
  {% endif %}
          </div>
        </li>
{% endfor %}
      </ul>
    </section>

{% endblock %}
