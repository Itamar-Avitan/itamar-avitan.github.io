{#- The frame every page is built in: head, the navigation strip, the identity above the page, and the
    colophon. Pages fill two blocks -- `identity` (the home page overrides it with its full masthead) and
    `main`. Every word still comes from site.yaml; this file holds markup only. -#}
{% import "macros.html.j2" as m with context %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
<link rel="canonical" href="{{ page_url }}">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ page_url }}">
<meta property="og:image" content="{{ site.site_url }}img/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }}. {{ site.identity_line }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2042%2010'%3E%3Cstyle%3Ecircle%7Bfill:%2314212B%7Drect%7Bfill:%230B5F73%7D@media%20(prefers-color-scheme:dark)%7Bcircle%7Bfill:%23E4EBEF%7Drect%7Bfill:%236DB3C4%7D%7D%3C/style%3E%3Ccircle%20cx='5'%20cy='5'%20r='5'/%3E%3Ccircle%20cx='21'%20cy='5'%20r='5'/%3E%3Crect%20x='32'%20width='10'%20height='10'/%3E%3C/svg%3E">
<script>
/* Theme toggle. Follows the system setting until the visitor chooses; the choice is remembered. */
(function () {
  var root = document.documentElement, KEY = "theme";
  var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  try {
    var saved = localStorage.getItem(KEY);
    if (saved === "light" || saved === "dark") root.setAttribute("data-theme", saved);
  } catch (e) {}
  function current() {
    return root.getAttribute("data-theme") || (mq && mq.matches ? "dark" : "light");
  }
  document.addEventListener("DOMContentLoaded", function () {
    /* The address stays written as "name [at] host" in the markup; the link is built from that text here. */
    var em = document.getElementById("email");
    if (em) {
      var a = document.createElement("a");
      a.id = "email";
      a.textContent = em.textContent;
      a.href = "mailto:" + em.textContent.replace(" [at] ", "@");
      em.parentNode.replaceChild(a, em);
    }

    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var label = btn.querySelector("span");
    function paint() { label.textContent = "Use " + (current() === "dark" ? "light" : "dark") + " theme"; }
    btn.hidden = false;
    paint();
    btn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem(KEY, next); } catch (e) {}
      paint();
    });
    if (mq && mq.addEventListener) mq.addEventListener("change", paint);
  });
})();
</script>
<link rel="stylesheet" href="{{ base }}style.css">
<script type="application/ld+json">{{ jsonld|safe }}</script>
</head>
<body>
<div class="page">

  <header>
{# The navigation strip: four ordinary links and the CV, on every page, above a hairline. The page you are on
   carries a 2px ink tick on that hairline -- the same tick that marks a section on the margin rule below, so
   moving between pages is the same gesture as moving between sections of one. aria-current says it again for
   a reader who cannot see the tick. The CV is the strip's one filled element, by the rule this site has kept
   throughout: a filled box is the single primary action in its group. #}
    <div class="topstrip">
      <nav class="sitenav" aria-label="Pages">
        <ul role="list">
{% for item in nav %}
          <li><a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
{% for link in site.links if link.label == "CV" and site.show_cv and link.get("url") %}
          <li class="sitenav__cv"><a class="btn btn--primary" href="{{ link.url|local(base) }}">{{ link.label }}</a></li>
{% endfor %}
        </ul>
      </nav>
      <button id="theme-toggle" class="toggle" type="button" hidden>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
        <span>Use dark theme</span>
      </button>
    </div>

{% block identity %}
{# Every page but the home page says whose site it is in two lines: the same portrait, small, the name, and
   the role line under it. The bio itself is said once, on the home page, and the address once in the
   colophon below. The name is not a link -- "Home" is the first item of the strip directly above it, and a
   second way home, in accent, would only make the identity read as a control. #}
    <div class="byline inset">
      <p class="byline__who">
        <picture><source srcset="{{ site.portrait.webp|local(base) }}" type="image/webp"><img src="{{ site.portrait.jpg|local(base) }}" width="36" height="36" alt="{{ site.portrait.alt }}"></picture>
        <span>{{ site.name }}</span>
      </p>
      {{ m.role_line()|trim }}
    </div>
{% endblock %}
  </header>

{# A page headed by its own h1 opens the margin rule half a line lower than a page that opens on an h2,
   because the rule starts on the first tick and the tick sits at the middle of that heading's first line. #}
  <main{% if page.get("heading") %} class="opens-with-h1"{% endif %}>
{% block main %}{% endblock %}
  </main>

  <footer class="colophon">
{# The profiles stand at the foot of every page, the home page included: six of them between the lede and the
   first word of the page pushed the content of a phone screen down by about 120px, and they are not what a
   visitor came to the front door for. The address is the half that is worth the top of the home page, so
   there it stays in the masthead and only the profiles are down here; every other page says both, since its
   masthead is a two-line byline. Either way each page says each of them exactly once. #}
{% set deep = page.get("heading")|default("", true)|length > 0 %}
    {{ m.contact("Contact and profiles" if deep else "Profiles", reach=deep, profiles=true)|trim }}
    <p class="row"><span class="when">Last updated</span> {{ m.dates(site.footer.updated, "what") }}</p>
    <svg class="mark inset" aria-hidden="true" viewBox="0 0 42 10" width="42" height="10"><circle cx="5" cy="5" r="5"/><circle cx="21" cy="5" r="5"/><rect x="32" width="10" height="10"/></svg>
  </footer>

</div>
</body>
</html>
