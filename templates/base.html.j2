{#- The frame every page is built in: head, the navigation strip, the identity above the page, and the
    colophon. Pages fill two blocks -- `identity` (the home page overrides it with its full masthead) and
    `main`. Every word still comes from site.yaml; this file holds markup only. -#}
{% import "macros.html.j2" as m with context %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
{# The 404 page has no address of its own -- it is served at whatever address was not found -- so it carries
   no canonical and no og:url, and asks not to be indexed instead. #}
{% if page.get("noindex") %}
<meta name="robots" content="noindex">
{% else %}
<link rel="canonical" href="{{ page_url }}">
{% endif %}
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_US">
{# The home page is his profile (a person, named by his own first and last name); every other page is a page
   of the site. #}
{% if not page.slug %}
<meta property="og:type" content="profile">
<meta property="profile:first_name" content="{{ site.name.split()[0] }}">
<meta property="profile:last_name" content="{{ site.name.split()[-1] }}">
{% else %}
<meta property="og:type" content="website">
{% endif %}
{% if not page.get("noindex") %}
<meta property="og:url" content="{{ page_url }}">
{% endif %}
{# The link-preview card: the name card (img/og.png: mark, name, role line, identity line) unless the page
   sets `og_image`, as the research page does with the paper's own card. The alt text follows the image, so
   it is the page's `og_image_alt` where there is one and the name card's description everywhere else. #}
<meta property="og:image" content="{{ site.site_url }}{{ page.get("og_image", "img/og.png") }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ page.get("og_image_alt", site.name ~ ". " ~ (site.role|map(attribute='label')|join(' · ') ~ ". " if site.get('role') else "") ~ site.identity_line) }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="light dark">
{# The mark as three files at the site root, written by tools/make_favicon.py from img/mark.svg: the PNG is
   what a search engine takes (square, larger than 48px, a raster format, crawlable), the SVG is what a browser
   that can use it takes (it keeps the dark-theme colours), and favicon.ico answers a client that asks for it
   blindly. The home-screen tile sets the row on the paper colour. Relative paths, like every other asset, so
   a page opened straight off the disk still finds them. #}
<link rel="icon" href="{{ base }}favicon-96.png" sizes="96x96" type="image/png">
<link rel="icon" href="{{ base }}favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ base }}apple-touch-icon.png">
<script>
/* Theme toggle. Follows the system setting until the visitor chooses; the choice is remembered. */
(function () {
  var root = document.documentElement, KEY = "theme";
  var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  try {
    var saved = localStorage.getItem(KEY);
    if (saved === "light" || saved === "dark") root.setAttribute("data-theme", saved);
  } catch (e) {}
  function current() {
    return root.getAttribute("data-theme") || (mq && mq.matches ? "dark" : "light");
  }
  document.addEventListener("DOMContentLoaded", function () {
    /* The address stays written as "name [at] host" in the markup; the link is built from that text here. */
    var em = document.getElementById("email");
    if (em) {
      var a = document.createElement("a");
      a.id = "email";
      a.textContent = em.textContent;
      a.href = "mailto:" + em.textContent.replace(" [at] ", "@");
      em.parentNode.replaceChild(a, em);
    }

    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var label = btn.querySelector("span");
    function paint() { label.textContent = "Use " + (current() === "dark" ? "light" : "dark") + " theme"; }
    btn.hidden = false;
    paint();
    btn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem(KEY, next); } catch (e) {}
      paint();
    });
    if (mq && mq.addEventListener) mq.addEventListener("change", paint);
  });
})();
</script>
<link rel="stylesheet" href="{{ base }}style.css">
<script type="application/ld+json">{{ jsonld|safe }}</script>
</head>
<body>
<div class="page">

  <header>
{# The navigation strip: four ordinary links and the CV, on every page, above a hairline. The page you are on
   carries a 2px ink tick on that hairline -- the same tick that marks a section on the margin rule below, so
   moving between pages is the same gesture as moving between sections of one. aria-current says it again for
   a reader who cannot see the tick. The CV is the strip's one filled element, by the rule this site has kept
   throughout: a filled box is the single primary action in its group. Its visible label stays "CV"; a hidden
   span adds the link's `format` from site.yaml ("PDF, 2 pages") to its accessible name, so a reader who
   cannot see the chip is told what opens before it opens, and `type` says the same to the browser (deep
   review 2026-09-25, PA-07). #}
    <div class="topstrip">
      <nav class="sitenav" aria-label="Pages">
        <ul role="list">
{% for item in nav %}
          <li><a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
{% for link in site.links if link.label == "CV" and site.show_cv and link.get("url") %}
          <li class="sitenav__cv"><a class="btn btn--primary" href="{{ link.url|local(base) }}" type="application/pdf">{{ link.label }}{% if link.get("format") %}<span class="vh"> ({{ link.format }})</span>{% endif %}</a></li>
{% endfor %}
        </ul>
      </nav>
      <button id="theme-toggle" class="toggle" type="button" hidden>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
        <span>Use dark theme</span>
      </button>
    </div>

{% block identity %}
{# Every page but the home page says whose site it is in two lines: the same portrait, small, the name, and
   the role line under it. The bio itself is said once, on the home page, and the address once in the
   colophon below. The name is not a link -- "Home" is the first item of the strip directly above it, and a
   second way home, in accent, would only make the identity read as a control. The portrait's alt is empty
   on purpose: the name is the next word, and a screen reader would otherwise say it twice (deep review
   2026-09-25, PA-05); the accessibility statement says so, so the two change together. #}
    <div class="byline inset">
      <p class="byline__who">
        <picture><source srcset="{{ site.portrait.webp|local(base) }}" type="image/webp"><img src="{{ site.portrait.jpg|local(base) }}" width="36" height="36" alt=""></picture>
        <span>{{ site.name }}</span>
      </p>
      {{ m.role_line()|trim }}
    </div>
{% endblock %}
  </header>

{# A page headed by its own h1 opens the margin rule half a line lower than a page that opens on an h2,
   because the rule starts on the first tick and the tick sits at the middle of that heading's first line. #}
  <main{% if page.get("heading") %} class="opens-with-h1"{% endif %}>
{% block main %}{% endblock %}
  </main>

  <footer class="colophon">
{# The profiles stand at the foot of every page, the home page included: six of them between the lede and the
   first word of the page pushed the content of a phone screen down by about 120px, and they are not what a
   visitor came to the front door for. The address is the half that is worth the top of the home page, so
   there it stays in the masthead and only the profiles are down here; every other page says both, since its
   masthead is a two-line byline. Each page says the address exactly once, and each profile once -- except
   GitHub and Google Scholar, which the home page also sets beside the address (the `pick` of `contact`). #}
{% set deep = page.get("heading")|default("", true)|length > 0 %}
    {{ m.contact("Contact and profiles" if deep else "Profiles", reach=deep, profiles=true)|trim }}
    <p class="row"><span class="when">Last updated</span> {{ m.dates(site.footer.updated, "what") }}</p>
{# The pages that are about the site rather than about him -- the accessibility statement, and anything of
   that kind added later. They stand here and not in the strip above, which carries the four pages a visitor
   came for; see the note over `pages` in site.yaml. Below "Last updated" on purpose: the margin rule ends on
   that row, and a link placed above it would take a tick and read as another section of the page. #}
{% if colophon_nav %}
    <nav class="colophon-nav" aria-label="About this site">
      <ul role="list">
{% for item in colophon_nav %}
        <li><a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
      </ul>
    </nav>
{% endif %}
{# The mark, at one and a half times its old size (63 by 15: at 42 by 10 the accent square was a speck), and
   beside it the one line that says what it is -- two alike and the odd one out, the task behind the paper --
   because it had stood at the foot of every page unexplained (deep review 2026-09-25, DS-10 and DI-01). The
   words come from site.yaml like every other word; the three shapes and their row are the owner's and stay
   as drawn (the favicon's arrangement is his question, Q-L). aria-hidden: the caption is the mark's text. #}
    <p class="mark-row inset"><svg class="mark" aria-hidden="true" viewBox="0 0 42 10" width="63" height="15"><circle cx="5" cy="5" r="5"/><circle cx="21" cy="5" r="5"/><rect x="32" width="10" height="10"/></svg><span class="mark-note">{{ site.footer.mark_note }}</span></p>
  </footer>

</div>
</body>
</html>
